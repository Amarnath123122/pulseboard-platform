// Pulseboard on Azure (microservices + API gateway), sized for a free-trial / low-cost subscription.
//   Browser -> Static Web App (UI)
//   Browser -> API Management (Consumption, pay-per-call) -> /identity -> identity app | /core -> api app
//   Browser -> api app (WebSocket only; Consumption APIM can't proxy WebSockets)
//   identity + api share one App Service plan and one Postgres server (separate databases).
//
//   Client ──HTTPS/WSS──► App Service (Linux B1, Python 3.12, managed identity)
//                              │            │                 │
//                              ▼            ▼                 ▼
//                  PostgreSQL Flexible   Storage Queue     Key Vault (secrets via
//                  (B1ms, free 750h)    (board reviews)    Key Vault references)
//
//   Application Insights (workspace-based, daily cap) + a 5xx alert + a budget alert watch it.
//   Scale up later by changing appServiceSku (S1/P0v3 unlock autoscale and slots).

targetScope = 'resourceGroup'

param location string = resourceGroup().location

@description('B1 is the cheapest tier with Always On (needed for the background review worker).')
param appServiceSku string = 'B1'

param postgresAdminLogin string = 'pbadmin'

@secure()
param postgresAdminPassword string

@secure()
@description('Base64 of the identity service RSA private key (PEM). Generated by scripts/azure-deploy.ps1.')
param identityJwtKeyB64 string

@secure()
@description('Password for the bootstrap admin account (ownerEmail).')
param adminPassword string

@secure()
param serviceKey string


@description('Static Web Apps (free tier) is only offered in some regions.')
@allowed(['westus2', 'centralus', 'eastus2', 'westeurope', 'eastasia'])
param webLocation string = 'eastasia'

@description('Receives alert and budget emails.')
param ownerEmail string

@description('Monthly budget for this resource group, in the subscription currency.')
param monthlyBudget int = 2000

param deployBudget bool = true

@description('Azure Managed Redis adds roughly 40-50 INR/day. Off: the API runs with caching disabled (still correct).')
param deployRedis bool = false
param budgetStartDate string = utcNow('yyyy-MM-01')

param tags object = { app: 'pulseboard', env: 'prod' }

var suffix = uniqueString(resourceGroup().id)
var dbName = 'pulseboard'
var queueName = 'board-reviews'
var roles = {
  storageQueueDataContributor: '974c5e8b-45b9-4653-ba55-5f855dd0fb88'
  keyVaultSecretsUser: '4633458b-17de-408a-b874-0445c86b69e6'
}

// ---------- Monitoring ----------
resource logs 'Microsoft.OperationalInsights/workspaces@2022-10-01' = {
  name: 'pb-logs-${suffix}'
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
    workspaceCapping: { dailyQuotaGb: json('0.15') } // stays inside the free 5 GB/month
  }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = {
  name: 'pb-insights-${suffix}'
  location: location
  tags: tags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logs.id
    SamplingPercentage: 50
  }
}

resource oncall 'Microsoft.Insights/actionGroups@2023-01-01' = {
  name: 'pb-oncall'
  location: 'global'
  tags: tags
  properties: {
    groupShortName: 'pb-oncall'
    enabled: true
    emailReceivers: [{ name: 'owner', emailAddress: ownerEmail, useCommonAlertSchema: true }]
  }
}

// ---------- Data ----------
resource postgres 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: 'pb-pg-${suffix}'
  location: location
  tags: tags
  sku: { name: 'Standard_B1ms', tier: 'Burstable' }
  properties: {
    version: '16'
    administratorLogin: postgresAdminLogin
    administratorLoginPassword: postgresAdminPassword
    storage: { storageSizeGB: 32, autoGrow: 'Disabled' }
    backup: { backupRetentionDays: 7, geoRedundantBackup: 'Disabled' }
    highAvailability: { mode: 'Disabled' }
  }
}

resource database 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: dbName
  properties: { charset: 'UTF8', collation: 'en_US.utf8' }
}

resource identityDatabase 'Microsoft.DBforPostgreSQL/flexibleServers/databases@2024-08-01' = {
  parent: postgres
  name: 'identity'
  properties: { charset: 'UTF8', collation: 'en_US.utf8' }
}

// Lets App Service reach the server. Next step for stricter isolation: VNet integration + private access.
resource allowAzure 'Microsoft.DBforPostgreSQL/flexibleServers/firewallRules@2024-08-01' = {
  parent: postgres
  name: 'AllowAzureServices'
  properties: { startIpAddress: '0.0.0.0', endIpAddress: '0.0.0.0' }
}

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: 'pbq${suffix}'
  location: location
  tags: tags
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: {
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
    allowSharedKeyAccess: false // managed identity only
    supportsHttpsTrafficOnly: true
  }
}

resource queueService 'Microsoft.Storage/storageAccounts/queueServices@2023-05-01' = {
  parent: storage
  name: 'default'
}

resource reviewQueue 'Microsoft.Storage/storageAccounts/queueServices/queues@2023-05-01' = {
  parent: queueService
  name: queueName
}

// ---------- Cache ----------
// Azure Managed Redis, smallest tier. TLS on 10000; the proxy-based cluster policy looks like a single node to clients.
resource redis 'Microsoft.Cache/redisEnterprise@2025-04-01' = if (deployRedis) {
  name: 'pb-redis-${suffix}'
  location: location
  tags: tags
  sku: { name: 'Balanced_B0' }
  properties: { minimumTlsVersion: '1.2' }
}

resource redisDb 'Microsoft.Cache/redisEnterprise/databases@2025-04-01' = if (deployRedis) {
  parent: redis
  name: 'default'
  properties: {
    clientProtocol: 'Encrypted'
    port: 10000
    clusteringPolicy: 'EnterpriseCluster'
    evictionPolicy: 'AllKeysLRU'
    accessKeysAuthentication: 'Enabled'
  }
}

// ---------- Secrets ----------
resource vault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: 'pb-kv-${suffix}'
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    softDeleteRetentionInDays: 7
  }
}

resource dbUrlSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'database-url'
  properties: {
    value: 'postgresql+asyncpg://${postgresAdminLogin}:${uriComponent(postgresAdminPassword)}@${postgres.properties.fullyQualifiedDomainName}:5432/${dbName}?ssl=require'
  }
}

resource redisUrlSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = if (deployRedis) {
  parent: vault
  name: 'redis-url'
  properties: {
    value: deployRedis ? 'rediss://:${uriComponent(redisDb!.listKeys().primaryKey)}@${redis!.properties.hostName}:10000/0' : ''
  }
}

resource identityDbUrlSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'identity-database-url'
  properties: {
    value: 'postgresql+asyncpg://${postgresAdminLogin}:${uriComponent(postgresAdminPassword)}@${postgres.properties.fullyQualifiedDomainName}:5432/identity?ssl=require'
  }
}

resource identityKeySecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'identity-jwt-key'
  properties: { value: identityJwtKeyB64 }
}

resource adminPasswordSecret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'identity-admin-password'
  properties: { value: adminPassword }
}

resource serviceKeyRef 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'service-key'
  properties: { value: serviceKey }
}

// ---------- Web UI ----------
resource web 'Microsoft.Web/staticSites@2023-12-01' = {
  name: 'pb-web-${suffix}'
  location: webLocation
  tags: tags
  sku: { name: 'Free', tier: 'Free' }
  properties: {}
}

// ---------- API ----------
resource plan 'Microsoft.Web/serverfarms@2023-12-01' = {
  name: 'pb-plan-${suffix}'
  location: location
  tags: tags
  kind: 'linux'
  sku: { name: appServiceSku }
  properties: { reserved: true }
}

resource api 'Microsoft.Web/sites@2023-12-01' = {
  name: 'pb-api-${suffix}'
  location: location
  tags: tags
  kind: 'app,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    serverFarmId: plan.id
    httpsOnly: true
    clientAffinityEnabled: false
    keyVaultReferenceIdentity: 'SystemAssigned'
    siteConfig: {
      linuxFxVersion: 'PYTHON|3.12'
      appCommandLine: 'bash startup.sh'
      alwaysOn: true
      webSocketsEnabled: true
      http20Enabled: true
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      healthCheckPath: '/healthz'
      appSettings: [
        { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'true' }
        { name: 'WEB_CONCURRENCY', value: '2' }
        { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: insights.properties.ConnectionString }
        { name: 'PB_ENVIRONMENT', value: 'production' }
        { name: 'PB_LOG_JSON', value: 'true' }
        { name: 'PB_DATABASE_URL', value: '@Microsoft.KeyVault(SecretUri=${dbUrlSecret.properties.secretUri})' }
        { name: 'PB_JWKS_URL', value: 'https://${identity.properties.defaultHostName}/.well-known/jwks.json' }
        { name: 'PB_SERVICE_KEY', value: '@Microsoft.KeyVault(SecretUri=${serviceKeyRef.properties.secretUri})' }
        { name: 'PB_CACHE_BACKEND', value: deployRedis ? 'redis' : 'none' }
        { name: 'PB_REDIS_URL', value: deployRedis ? '@Microsoft.KeyVault(SecretUri=${redisUrlSecret!.properties.secretUri})' : '' }
        { name: 'PB_DB_AUTO_CREATE', value: 'false' }
        { name: 'PB_QUEUE_BACKEND', value: 'azure' }
        { name: 'PB_REVIEW_QUEUE_NAME', value: queueName }
        { name: 'PB_AZURE_QUEUE_ACCOUNT_URL', value: storage.properties.primaryEndpoints.queue }
        { name: 'PB_CORS_ORIGINS', value: '[]' } // browsers come through the gateway, which answers CORS
      ]
    }
  }
}

resource identity 'Microsoft.Web/sites@2023-12-01' = {
  name: 'pb-id-${suffix}'
  location: location
  tags: tags
  kind: 'app,linux'
  identity: { type: 'SystemAssigned' }
  properties: {
    serverFarmId: plan.id // same plan as the API: no extra compute cost
    httpsOnly: true
    clientAffinityEnabled: false
    keyVaultReferenceIdentity: 'SystemAssigned'
    siteConfig: {
      linuxFxVersion: 'PYTHON|3.12'
      appCommandLine: 'bash startup.sh'
      alwaysOn: true
      http20Enabled: true
      ftpsState: 'Disabled'
      minTlsVersion: '1.2'
      healthCheckPath: '/healthz'
      appSettings: [
        { name: 'SCM_DO_BUILD_DURING_DEPLOYMENT', value: 'true' }
        { name: 'WEB_CONCURRENCY', value: '2' }
        { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: insights.properties.ConnectionString }
        { name: 'ID_ENVIRONMENT', value: 'production' }
        { name: 'ID_LOG_JSON', value: 'true' }
        { name: 'ID_DATABASE_URL', value: '@Microsoft.KeyVault(SecretUri=${identityDbUrlSecret.properties.secretUri})' }
        { name: 'ID_DB_AUTO_CREATE', value: 'false' }
        { name: 'ID_JWT_PRIVATE_KEY_B64', value: '@Microsoft.KeyVault(SecretUri=${identityKeySecret.properties.secretUri})' }
        { name: 'ID_BOOTSTRAP_ADMIN_EMAIL', value: ownerEmail }
        { name: 'ID_BOOTSTRAP_ADMIN_PASSWORD', value: '@Microsoft.KeyVault(SecretUri=${adminPasswordSecret.properties.secretUri})' }
        { name: 'ID_CORS_ORIGINS', value: '[]' }
      ]
    }
  }
}

resource identityReadsSecrets 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(vault.id, identity.id, roles.keyVaultSecretsUser)
  scope: vault
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.keyVaultSecretsUser)
    principalId: identity.identity.principalId
    principalType: 'ServicePrincipal'
  }
}

// ---------- API gateway: API Management, Consumption tier (first 1M calls/month free) ----------
resource gateway 'Microsoft.ApiManagement/service@2022-08-01' = {
  name: 'pb-gw-${suffix}'
  location: location
  tags: tags
  sku: { name: 'Consumption', capacity: 0 }
  properties: { publisherEmail: ownerEmail, publisherName: 'Pulseboard' }
}

var webOrigin = 'https://${web.properties.defaultHostname}'
var corsPolicy = '<cors allow-credentials="false"><allowed-origins><origin>${webOrigin}</origin><origin>http://localhost:5173</origin></allowed-origins><allowed-methods preflight-result-max-age="600"><method>GET</method><method>POST</method><method>PUT</method><method>PATCH</method><method>DELETE</method><method>OPTIONS</method></allowed-methods><allowed-headers><header>Authorization</header><header>Content-Type</header><header>X-Request-ID</header></allowed-headers><expose-headers><header>X-Request-ID</header></expose-headers></cors>'

var gatewayApis = [
  { name: 'identity', path: 'identity', backend: 'https://${identity.name}.azurewebsites.net', templates: ['/api/v1/auth/*', '/api/v1/users', '/api/v1/users/*', '/.well-known/*'] }
  { name: 'core', path: 'core', backend: 'https://${api.name}.azurewebsites.net', templates: ['/api/v1/*'] }
]
var methods = ['GET', 'POST', 'PUT', 'PATCH', 'DELETE']

resource gatewayApi 'Microsoft.ApiManagement/service/apis@2022-08-01' = [for a in gatewayApis: {
  parent: gateway
  name: a.name
  properties: {
    displayName: 'Pulseboard ${a.name}'
    path: a.path
    protocols: ['https']
    serviceUrl: a.backend
    subscriptionRequired: false // public SPA; each service verifies the bearer token itself
  }
}]

// Only these routes exist on the gateway: /internal, /docs and anything else are not reachable from outside.
resource identityOps 'Microsoft.ApiManagement/service/apis/operations@2022-08-01' = [for (op, i) in flatten(map(gatewayApis[0].templates, t => map(methods, m => { t: t, m: m }))): {
  parent: gatewayApi[0]
  name: 'op-${i}'
  properties: { displayName: '${op.m} ${op.t}', method: op.m, urlTemplate: op.t }
}]

resource coreOps 'Microsoft.ApiManagement/service/apis/operations@2022-08-01' = [for (m, i) in methods: {
  parent: gatewayApi[1]
  name: 'op-${i}'
  properties: { displayName: '${m} /api/v1/*', method: m, urlTemplate: '/api/v1/*' }
}]

// CORS at the edge; no response buffering so the assistant's SSE stream flows through.
resource gatewayPolicies 'Microsoft.ApiManagement/service/apis/policies@2022-08-01' = [for (a, i) in gatewayApis: {
  parent: gatewayApi[i]
  name: 'policy'
  properties: {
    format: 'rawxml'
    value: '<policies><inbound><base />${corsPolicy}<set-header name="X-Forwarded-For" exists-action="override"><value>@(context.Request.IpAddress)</value></set-header></inbound><backend><forward-request timeout="120" buffer-response="false" /></backend><outbound><base /></outbound><on-error><base /></on-error></policies>'
  }
}]

resource apiReadsSecrets 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(vault.id, api.id, roles.keyVaultSecretsUser)
  scope: vault
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.keyVaultSecretsUser)
    principalId: api.identity.principalId
    principalType: 'ServicePrincipal'
  }
}

resource apiUsesQueue 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(storage.id, api.id, roles.storageQueueDataContributor)
  scope: storage
  properties: {
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', roles.storageQueueDataContributor)
    principalId: api.identity.principalId
    principalType: 'ServicePrincipal'
  }
}

resource serverErrorsAlert 'Microsoft.Insights/metricAlerts@2018-03-01' = {
  name: 'pb-api-5xx'
  location: 'global'
  tags: tags
  properties: {
    description: 'API returned more than 10 server errors in 5 minutes'
    severity: 2
    enabled: true
    scopes: [api.id]
    evaluationFrequency: 'PT5M'
    windowSize: 'PT5M'
    criteria: {
      'odata.type': 'Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria'
      allOf: [
        {
          name: 'http5xx'
          criterionType: 'StaticThresholdCriterion'
          metricName: 'Http5xx'
          operator: 'GreaterThan'
          threshold: 10
          timeAggregation: 'Total'
        }
      ]
    }
    actions: [{ actionGroupId: oncall.id }]
  }
}

resource budget 'Microsoft.Consumption/budgets@2023-05-01' = if (deployBudget) {
  name: 'pb-monthly-budget'
  properties: {
    category: 'Cost'
    amount: monthlyBudget
    timeGrain: 'Monthly'
    timePeriod: { startDate: budgetStartDate }
    notifications: {
      actual50: {
        enabled: true, operator: 'GreaterThan', threshold: 50, thresholdType: 'Actual', contactEmails: [ownerEmail]
      }
      forecast100: {
        enabled: true, operator: 'GreaterThan', threshold: 100, thresholdType: 'Forecasted', contactEmails: [ownerEmail]
      }
    }
  }
}

output apiAppName string = api.name
output apiUrl string = 'https://${api.properties.defaultHostName}'
output websocketUrl string = 'wss://${api.properties.defaultHostName}/ws/events'
output webAppName string = web.name
output webUrl string = 'https://${web.properties.defaultHostname}'
output identityAppName string = identity.name
output identityUrl string = 'https://${identity.properties.defaultHostName}'
output gatewayUrl string = gateway.properties.gatewayUrl
output keyVaultName string = vault.name
output postgresHost string = postgres.properties.fullyQualifiedDomainName
output appInsightsName string = insights.name
